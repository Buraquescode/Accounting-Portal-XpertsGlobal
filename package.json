{
  "name": "accounting-portal",
  "version": "1.0.0",
  "description": "Work in progress.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "npm --prefix backend test",
    "dev": "concurrently -n api,web -c blue,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "db:up": "docker compose up -d",
    "db:migrate": "npm --prefix backend run prisma:migrate",
    "db:seed": "npm --prefix backend run prisma:seed",
    "db:reset": "npm --prefix backend exec -- prisma migrate reset --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": "true",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
